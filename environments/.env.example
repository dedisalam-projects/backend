# =============================================================================
# Backend Environment Configuration Template
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000

# Security / Authentication
JWT_SECRET=supersecretjwtkey12345
JWT_EXPIRES_IN=15m

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@172.16.254.5:5672

# Cache & Session (Redis)
REDIS_URL=redis://172.16.254.6:6379

# MongoDB (Shared Instance)
MONGODB_URI=mongodb://172.16.254.3:27017?authSource=admin
