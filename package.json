{
  "name": "@dedisalam/backend",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "infra:up": "docker compose -f ../infrastructure/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f ../infrastructure/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f ../infrastructure/docker-compose.dev.yml logs -f",
    "seed": "node scripts/seed.js",
    "test": "nx run-many --target=test --all",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "test:unit": "nx run-many --target=test --all --runInBand --coverage",
    "test:pbt": "jest --testMatch='**/*.pbt.spec.ts'",
    "test:contract": "jest libs/common/src/test/contracts/event-contracts.spec.ts --testPathIgnorePatterns=node_modules",
    "test:integration": "jest libs/common/src/test/integration/realtime-e2e.integration.spec.ts --testPathIgnorePatterns=node_modules --runInBand --forceExit",
    "test:load": "jest libs/common/src/test/load/socketio-load.spec.ts --testPathIgnorePatterns=node_modules --runInBand --forceExit",
    "test:resilience": "jest libs/common/src/test/resilience/resilience-chaos.spec.ts --testPathIgnorePatterns=node_modules --runInBand --forceExit",
    "test:mutation": "stryker run",
    "test:security": "jest libs/common/src/test/security/websocket-security.spec.ts --testPathIgnorePatterns=node_modules --runInBand --forceExit",
    "test:soak": "jest libs/common/src/test/soak/memory-soak.spec.ts --testPathIgnorePatterns=node_modules --runInBand --forceExit",
    "test:matrix:all": "npm run test:unit && npm run test:contract && npm run test:security && npm run test:soak && npm run test:integration && npm run test:resilience && npm run test:load",
    "docker:build:prod": "docker build -t dedisalam/backend-gateway:latest -f docker/gateway/Dockerfile . && docker build -t dedisalam/backend-user-service:latest -f docker/user-service/Dockerfile . && docker build -t dedisalam/backend-notification-service:latest -f docker/notification-service/Dockerfile .",
    "docker:push:prod": "docker push dedisalam/backend-gateway:latest && docker push dedisalam/backend-user-service:latest && docker push dedisalam/backend-notification-service:latest"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "^23.2.0",
    "@nx/eslint-plugin": "^23.2.0",
    "@nx/jest": "^23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/nest": "^23.2.0",
    "@nx/node": "^23.2.0",
    "@nx/web": "^23.2.0",
    "@nx/webpack": "^23.2.0",
    "@nx/workspace": "^23.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/node-vault": "^0.9.1",
    "@types/passport-jwt": "^4.0.1",
    "artillery": "^2.0.34",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.0.8",
    "nx": "^23.2.0",
    "prettier": "~3.6.2",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.7",
    "ts-node": "^10.9.1",
    "tslib": "^2.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4",
    "nestjs-pino": "^4.6.1",
    "node-vault": "^0.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  }
}
