# Server Configuration
NODE_ENV=development
PORT=3000
GATEWAY_TCP_PORT=4010

# MongoDB
MONGODB_URI=mongodb://root:rootpassword@127.0.0.1:27017/dedisalam?authSource=admin

# Redis (Caching & Session Storage)
REDIS_URL=redis://:redispassword@127.0.0.1:6379

# RabbitMQ (Microservice Message Broker)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Security / Authentication
JWT_SECRET=dedisalam_development_jwt_secret_2026

# Infrastructure Initialization Credentials
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword
RABBITMQ_USER=guest
RABBITMQ_PASS=rootpassword
REDIS_PASSWORD=rootpassword

# Infrastructure Host Bind IPs (Defaults to 127.0.0.1 for local Docker execution)
MONGO_BIND_IP=127.0.0.1
REDIS_BIND_IP=127.0.0.1
RABBITMQ_BIND_IP=127.0.0.1

NOTIFICATION_SERVICE_TCP_PORT=3022
